#!/usr/bin/env python3
"""Docker credential helper: obtain a token only for this installation's registry."""
import json
from pathlib import Path
import re
import sys
from uncloud_gcp import access_token


def credentials(server, config):
    host = config['registry_host']
    if not re.fullmatch(r'[a-z0-9-]+-docker\.pkg\.dev', host):
        raise ValueError('Invalid customer registry hostname')
    if server not in (host, 'https://' + host):
        raise ValueError('Registry is outside the installation scope')
    return {'ServerURL': server, 'Username': 'oauth2accesstoken',
            'Secret': access_token(config['service_account'])}


def main():
    action = sys.argv[1] if len(sys.argv) == 2 else ''
    if action == 'get':
        config = json.loads(Path('/etc/certlocker/gcp-registry.json').read_text())
        print(json.dumps(credentials(sys.stdin.readline(512).strip(), config)))
    elif action == 'list':
        print('{}')
    elif action == 'erase':
        pass  # Nothing is stored.
    else:
        raise ValueError('This helper never stores credentials')


if __name__ == '__main__':
    try:
        main()
    except Exception:
        print('VM registry authentication failed; details suppressed', file=sys.stderr)
        sys.exit(1)
