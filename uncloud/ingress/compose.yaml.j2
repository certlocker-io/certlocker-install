name: certlocker-{{ uncloud_company }}-ingress
services:
  haproxy:
    image: docker.io/library/haproxy@sha256:2caaf8b1a1ef67f3f1ea9b721f2821675d3ba4500fb518e23884fecb93e8dbaa
    container_name: certlocker-haproxy
    user: '0:0'
    network_mode: host
    cap_drop: [ALL]
    cap_add: [NET_BIND_SERVICE]
    security_opt: [no-new-privileges:true]
    restart: always
    mem_limit: 256m
    volumes:
      - ./:/usr/local/etc/haproxy:ro
      - /run/certlocker/{{ uncloud_company }}/ingress:/run/secrets:ro
      - /run/certlocker/{{ uncloud_company }}/haproxy:/run/haproxy
    healthcheck:
      test: [CMD-SHELL, 'wget -qO- http://127.0.0.1:8404/health/ready >/dev/null']
      interval: 5s
      timeout: 3s
      retries: 12
    logging:
      driver: local
      options: {max-size: '20m', max-file: '5'}
