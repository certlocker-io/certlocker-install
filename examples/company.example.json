  "front_url": "https://certlocker.example.com",
  "backoffice_url": "https://backoffice.example.com",
  "grafana_url": "https://grafana-cl-example.example.com",
  "initial_admin_email": "admin@example.com",
  "account_domain": "example.com",
  "admin_display_name": "Company administrator",
  "smtp_mode": "customer",
  "smtp_host": "smtp.example.com",
  "smtp_user": "certlocker@example.com",
  "smtp_port": 587,
  "smtp_tls": "starttls",
  "cloudflare_load_balancing": true,
  "cloudflare_monitor_interval": 60,
