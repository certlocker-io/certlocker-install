{
  "company": "example",
  "deployment": "prod",
  "google_project": "REPLACE-google-project",
  "ssh_user": "ucdeploy",
  "ssh_private_key": "~/.ssh/certlocker-example",
  "nodes": {
    "example-a": {
      "zone": "europe-west1-b",
      "machine_type": "e2-standard-2"
    },
    "example-b": {
      "zone": "europe-west4-a",
      "machine_type": "e2-standard-2"
    }
  },
  "boot_disk_size_gb": 100,
  "operator_cidrs": [
    "198.51.100.10/32"
  ],
  "vpn_cidrs": [],
  "trust_group": "REPLACE-company-group",
  "registry_mode": "ghcr",
  "runtime_backend": "host",
  "certificate_mode": "customer",
  "dns_zone": "example.com",
